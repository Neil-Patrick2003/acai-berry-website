# Pancake POS — https://docs.pancake.biz/pos/api/en/
# Create the key in POS: Settings -> Application -> API KEY -> Create.
# Copy this file to .env.local and fill it in. Never prefix these with
# NEXT_PUBLIC_ — that would ship the key to every visitor's browser.

PANCAKE_API_KEY=
PANCAKE_SHOP_ID=

# Override only if Pancake gives you a different host.
# PANCAKE_API_BASE=https://pos.pages.fm/api/v1
